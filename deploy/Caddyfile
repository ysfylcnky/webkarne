# WebKarne production site block (Caddy >= 2.7 for the heredoc below).
# Merge into /etc/caddy/Caddyfile, then:  sudo caddy validate --config /etc/caddy/Caddyfile
#                                          sudo systemctl reload caddy
# Cloudflare: proxied DNS, SSL/TLS mode "Full (strict)".

webkarne.com {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		# No inline script/style anywhere in the UI; fonts come from Google Fonts.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# RFC 9116. Renew "Expires" before it passes (max. one year ahead).
	handle /.well-known/security.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond <<TXT
			Contact: mailto:security@webkarne.com
			Expires: 2027-09-01T00:00:00.000Z
			Preferred-Languages: tr, en
			Canonical: https://webkarne.com/.well-known/security.txt
			TXT 200
	}

	handle {
		reverse_proxy 127.0.0.1:8000
	}
}

www.webkarne.com {
	redir https://webkarne.com{uri} permanent
}
